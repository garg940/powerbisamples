table 'Calculation group'
	lineageTag: 5734670d-8ed0-49fc-bc48-86109dac9745

	calculationGroup

		calculationItem 'Calculation item' = ```
				
				if(
				    SELECTEDVALUE(Data[Type]) = "Total Cash, Start of Year" &&    
				    ( ISINSCOPE(Data[Activity Type])  || ISINSCOPE(Data[Description]) ) ,
				    blank(), 
				    SELECTEDMEASURE()
				)
				```

